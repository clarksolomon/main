prefix=/home/solomon/workspace/difx/gpu-difx-install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: fxcorr
Description: Library of all mpifxcorr objects that don't need MPI, useful for other programs which communicate to mpifxcorr
Requires:
Version: 2.9
Libs: -L${libdir} -lfxcorr -lmark5access -L/opt/intel/oneapi/ipp/2021.10/lib/intel64 -L/opt/intel/oneapi/ipp/2021.10/ipp/lib/intel64 -L/opt/intel/oneapi/ipp/2021.10/compiler/lib/intel64 -Wl,-rpath,/opt/intel/oneapi/ipp/2021.10/lib/intel64 -Wl,-rpath,/opt/intel/oneapi/ipp/2021.10/ipp/lib/intel64 -lipps -lippvm -lippcore -lpthread 
Cflags: -I${includedir}/mpifxcorr -DIPP9 -I/opt/intel/oneapi/ipp/2021.10/include/ipp

