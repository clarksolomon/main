prefix=/home/solomon/workspace/difx/gpu-difx-install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
	
Name: vdifio
Description: Library for parsing VDIF header frames, multiplexing VDIF data, and summarizing contents of VDIF files
Requires:
Version: 1.6
Libs: -L${libdir} -lvdifio 
Cflags: -I${includedir}
